<svg width="1200" height="630" viewBox="0 0 1200 630" xmlns="http://www.w3.org/2000/svg">
  <!-- Background -->
  <rect width="1200" height="630" fill="#1e40af"/>
  
  <!-- Gradient overlay -->
  <defs>
    <linearGradient id="grad1" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#3b82f6;stop-opacity:0.8" />
      <stop offset="100%" style="stop-color:#1e40af;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="1200" height="630" fill="url(#grad1)"/>
  
  <!-- Logo/Brand area -->
  <rect x="50" y="50" width="120" height="120" rx="15" fill="#ffffff" opacity="0.1"/>
  
  <!-- Main title -->
  <text x="200" y="120" font-family="Arial, sans-serif" font-size="48" font-weight="bold" fill="#ffffff">
    مـركـبـا
  </text>
  
  <!-- Subtitle -->
  <text x="200" y="170" font-family="Arial, sans-serif" font-size="24" fill="#e5e7eb">
    الـمـنـصـة الاخـبـاريـة
  </text>
  
  <!-- English subtitle -->
  <text x="200" y="210" font-family="Arial, sans-serif" font-size="18" fill="#d1d5db">
    Marakba - News Platform
  </text>
  
  <!-- News icon/decoration -->
  <g transform="translate(800, 200)">
    <!-- Newspaper icon -->
    <rect x="0" y="0" width="300" height="200" rx="10" fill="#ffffff" opacity="0.1"/>
    <rect x="20" y="20" width="260" height="30" rx="5" fill="#ffffff" opacity="0.3"/>
    <rect x="20" y="70" width="120" height="15" rx="3" fill="#ffffff" opacity="0.2"/>
    <rect x="20" y="95" width="180" height="15" rx="3" fill="#ffffff" opacity="0.2"/>
    <rect x="20" y="120" width="140" height="15" rx="3" fill="#ffffff" opacity="0.2"/>
    <rect x="20" y="145" width="200" height="15" rx="3" fill="#ffffff" opacity="0.2"/>
    
    <!-- Second column -->
    <rect x="160" y="70" width="120" height="15" rx="3" fill="#ffffff" opacity="0.2"/>
    <rect x="160" y="95" width="100" height="15" rx="3" fill="#ffffff" opacity="0.2"/>
    <rect x="160" y="120" width="120" height="15" rx="3" fill="#ffffff" opacity="0.2"/>
    <rect x="160" y="145" width="80" height="15" rx="3" fill="#ffffff" opacity="0.2"/>
  </g>
  
  <!-- Bottom tagline -->
  <text x="50" y="550" font-family="Arial, sans-serif" font-size="20" fill="#e5e7eb">
    آخر الأخبار والتحديثات • Latest News and Updates
  </text>
  
  <!-- Website URL -->
  <text x="50" y="580" font-family="Arial, sans-serif" font-size="16" fill="#d1d5db">
    markaba.news
  </text>
</svg>